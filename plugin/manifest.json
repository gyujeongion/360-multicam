{
  "manifestVersion": 5,
  "id": "dev.orbcut.panel",
  "name": "orbcut",
  "version": "0.2.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "orbcutPanel",
      "label": { "default": "orbcut" },
      "minimumSize": { "width": 280, "height": 360 },
      "preferredDockedSize": { "width": 320, "height": 560 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "fullAccess" }
}
